{
  "name": "nwflash-desktop-e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "pretest": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build-native-e2e.ps1",
    "pretest:native": "npm run pretest",
    "pretest:visual": "npm --prefix .. run build",
    "test": "npm run test:native && npm run test:visual",
    "test:native": "wdio run ./wdio.conf.ts",
    "test:visual": "wdio run ./wdio.visual.conf.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@wdio/cli": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "@wdio/tauri-service": "^1.3.0",
    "expect-webdriverio": "^5.6.5",
    "typescript": "^5.8.2"
  }
}
