{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "types": [
      "vite/client",
      "vitest/globals"
    ],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@nwflash/e2e-bridge": ["./src/test/e2e-bridge.ts"],
      "@nwflash/tauri-core-native": ["./node_modules/@tauri-apps/api/core"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
