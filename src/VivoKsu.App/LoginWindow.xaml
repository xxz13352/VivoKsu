<Window x:Class="VivoKsu.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录 Nwflash 奶娃Flash" Width="400" Height="564"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" TextOptions.TextFormattingMode="Display"
        ShowInTaskbar="True">
  <Window.Resources>
    <!-- 低饱和 teal 体系(与主窗口一致,局部定义) -->
    <SolidColorBrush x:Key="Ink" Color="#0A2E2B"/>
    <SolidColorBrush x:Key="Teal" Color="#0B6E68"/>
    <SolidColorBrush x:Key="TealDark" Color="#085B56"/>
    <SolidColorBrush x:Key="TealSoft" Color="#E3F0EE"/>
    <SolidColorBrush x:Key="Muted" Color="#5C6E69"/>
    <SolidColorBrush x:Key="Danger" Color="#C23B30"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#FBEFED"/>
    <SolidColorBrush x:Key="Line" Color="#E3E9E7"/>
    <SolidColorBrush x:Key="FieldHover" Color="#C9D6D3"/>
    <SolidColorBrush x:Key="CardLine" Color="#D9E3E0"/>

    <!-- 输入框:细边框 + 聚焦 teal 描边 + 极淡聚焦外圈 -->
    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Height" Value="42"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Teal}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid>
              <Border x:Name="Halo" Background="{StaticResource TealSoft}" Opacity="0" CornerRadius="11" Margin="-2" IsHitTestVisible="False"/>
              <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" SnapsToDevicePixels="True">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FieldHover}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Teal}"/>
                <Setter TargetName="Halo" Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FieldPw" TargetType="PasswordBox">
      <Setter Property="Height" Value="42"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Grid>
              <Border x:Name="Halo" Background="{StaticResource TealSoft}" Opacity="0" CornerRadius="11" Margin="-2" IsHitTestVisible="False"/>
              <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" SnapsToDevicePixels="True">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FieldHover}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Teal}"/>
                <Setter TargetName="Halo" Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 密码显示/隐藏眼睛按钮(CheckBox 自持勾选态,Click 交由代码层翻转 PasswordChar) -->
    <Style x:Key="EyeToggleStyle" TargetType="CheckBox">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="EyeSurface" CornerRadius="7" Background="Transparent">
              <Grid>
                <TextBlock x:Name="EyeClosed" Text="&#xE8D3;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="EyeOpen" Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource Teal}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="EyeSurface" Property="Background" Value="#F0F5F4"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="EyeClosed" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="EyeOpen" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 主按钮:全宽 teal,悬停加深,按下 0.97 缩放 + 0.85 透明(对齐 ToolButtonStyle 交互) -->
    <Style x:Key="PrimaryLoginButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="44"/>
      <Setter Property="Background" Value="{StaticResource Teal}"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" SnapsToDevicePixels="True"/>
              <Border x:Name="HoverShade" Background="#14087A70" CornerRadius="9" Opacity="0" IsHitTestVisible="False"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <EventTrigger RoutedEvent="Mouse.MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverShade" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></EventTrigger>
              <EventTrigger RoutedEvent="Mouse.MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverShade" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></EventTrigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#8FD1CA"/>
                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 右上角关闭:悬停软红 -->
    <Style x:Key="CloseIconButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerSoft}"/>
                <Setter Property="Foreground" Value="{StaticResource Danger}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Background="Transparent" Padding="24">
    <Border Background="#FFFFFF" CornerRadius="16" BorderBrush="{StaticResource CardLine}" BorderThickness="1" SnapsToDevicePixels="True">
      <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#0A2E2B" Opacity="0.10"/>
      </Border.Effect>
      <Grid>
        <Grid Margin="30,26,30,26">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- 品牌区:logo + 产品名 + 等宽版本行 -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource Teal}" BorderBrush="#1F7B73" BorderThickness="1">
                <TextBlock Text="NWF" Foreground="White" FontFamily="Segoe UI" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Nwflash 奶娃Flash" Foreground="{StaticResource Ink}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="ROM CONTROL · API.NWFLASH.CC.CD" FontFamily="Cascadia Mono" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
              </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" x:Name="CloseButton" Content="✕" Style="{StaticResource CloseIconButtonStyle}" VerticalAlignment="Top" ToolTip="关闭" AutomationProperties.Name="关闭"/>
          </Grid>

          <!-- 主标题 + 副文案 -->
          <StackPanel Grid.Row="1" Margin="0,26,0,0">
            <TextBlock Text="SECURE SIGN IN" FontFamily="Cascadia Mono" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Teal}"/>
            <TextBlock Text="登录 Nwflash" Margin="0,6,0,0" Foreground="{StaticResource Ink}" FontSize="23" FontWeight="Bold"/>
            <TextBlock Text="商业工具授权。使用后台分配的账号登录后进入主界面。" Margin="0,7,0,0" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="20"/>
          </StackPanel>

          <!-- 账号 -->
          <StackPanel Grid.Row="2" Margin="0,22,0,0">
            <TextBlock Text="账号" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,0,0,6"/>
            <TextBox x:Name="UsernameBox" Style="{StaticResource Field}" FontFamily="Cascadia Mono" FontSize="13" AutomationProperties.Name="账号"/>
          </StackPanel>

          <!-- 密码(含显示/隐藏) -->
          <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="密码" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,0,0,6"/>
            <Grid>
              <PasswordBox x:Name="PasswordBox" Style="{StaticResource FieldPw}" FontFamily="Cascadia Mono" FontSize="13" Padding="12,0,44,0" AutomationProperties.Name="密码"/>
              <CheckBox x:Name="PasswordToggleButton" Style="{StaticResource EyeToggleStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0" AutomationProperties.Name="显示或隐藏密码" ToolTip="显示或隐藏密码" Click="OnPasswordToggleClick"/>
            </Grid>
          </StackPanel>

          <!-- 错误提示(按钮上方,常驻占位避免布局跳动) -->
          <TextBlock Grid.Row="4" x:Name="ErrorText" Margin="0,4,0,0" MinHeight="18" Foreground="{StaticResource Danger}" FontSize="12" TextWrapping="Wrap"/>

          <!-- 主按钮 -->
          <Grid Grid.Row="5" Margin="0,14,0,0">
            <Button x:Name="LoginButton" Content="登 录" Style="{StaticResource PrimaryLoginButtonStyle}" AutomationProperties.Name="登录"/>
          </Grid>
        </Grid>

        <!-- 登录中覆盖层:半透明遮罩 + 居中旋转 spinner + "正在登录…" -->
        <Grid x:Name="BusyOverlay" Visibility="Collapsed">
          <Border Background="#ECFFFFFF" CornerRadius="16">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <Grid Width="28" Height="28">
                <Path x:Name="SpinnerArc" RenderTransformOrigin="0.5,0.5" Data="M 14,3 A 11,11 0 1 1 3,14" Stroke="{StaticResource Teal}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                  <Path.RenderTransform>
                    <RotateTransform x:Name="SpinnerSpin"/>
                  </Path.RenderTransform>
                </Path>
              </Grid>
              <TextBlock Text="正在登录…" Margin="0,14,0,0" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                  <DoubleAnimation Storyboard.TargetName="SpinnerSpin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.1"/>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </Grid.Triggers>
        </Grid>
      </Grid>
    </Border>
  </Border>
</Window>
