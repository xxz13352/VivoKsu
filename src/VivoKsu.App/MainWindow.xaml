              <TextBlock Text="payload_dumper 就绪" FontSize="11" Foreground="{StaticResource ConnectionBrush}"/>
            </StackPanel>
          </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}" Padding="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="46"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="#F6FAFA" BorderBrush="#D8E8E5" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="18,14">
              <Grid>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="路径 / URL" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBox Grid.Column="1" Height="30" VerticalContentAlignment="Center" Padding="10,0" Text="{Binding FirmwareExtract.PayloadSourceUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="本地 payload.bin/.zip 路径，或 http/https 云端直链（HTTP Range 按需下载）"/>
                <Button Grid.Column="2" Content="选择" Style="{StaticResource ToolButtonStyle}" Command="{Binding FirmwareExtract.SelectPayloadCommand}" Margin="10,0,0,0" Padding="11,6" AutomationProperties.Name="选择固件"/>
                <TextBlock Grid.Row="1" Text="输出路径" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,10,12,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" Height="30" Margin="0,10,0,0" VerticalContentAlignment="Center" Padding="10,0" Text="{Binding FirmwareExtract.OutputPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="提取镜像的保存文件夹；留空使用临时目录"/>
                <Button Grid.Row="1" Grid.Column="2" Content="选择" Style="{StaticResource ToolButtonStyle}" Command="{Binding FirmwareExtract.SelectOutputPathCommand}" Margin="10,10,0,0" Padding="11,6" AutomationProperties.Name="选择输出目录"/>
