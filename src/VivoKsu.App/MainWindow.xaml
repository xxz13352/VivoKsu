                        <TextBlock Grid.Column="1" Text="{Binding Name, Mode=OneWay}" FontFamily="Cascadia Mono" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="11,0,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding SizeText, Mode=OneWay}" FontFamily="Cascadia Mono" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <Border Grid.Column="3" CornerRadius="4" Background="#EAF4F3" Padding="6,3" VerticalAlignment="Center" Margin="10,0,0,0">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding CompressionType}" Value="none"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <TextBlock Text="{Binding CompressionType, Mode=OneWay}" FontFamily="Cascadia Mono" FontSize="9" Foreground="{StaticResource ConnectionBrush}"/>
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Border Background="#FFFFFF" IsHitTestVisible="False">
