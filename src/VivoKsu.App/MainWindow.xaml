            <TextBlock Text="KernelSU 启动镜像修补与刷写" Style="{StaticResource PageSubtitleStyle}"/>
          </StackPanel>
          <Border Grid.Column="1" Style="{StaticResource StatusChipStyle}" VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource ConnectionBrush}" Margin="0,4,8,0"/><TextBlock Text="{Binding Root.PreflightSummary}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ConnectionBrush}"/></StackPanel>
          </Border>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}" Padding="0">
