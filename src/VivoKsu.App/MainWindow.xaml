                  </StackPanel>
                  <TextBlock Text="官版 KSU 全自动需另选 vendor_boot。" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="选择 init_boot 镜像" Style="{StaticResource ToolButtonStyle}" Command="{Binding Root.BrowseImageCommand}" VerticalAlignment="Center" Margin="12,0,0,0" Padding="11,7" AutomationProperties.Name="选择 init_boot 镜像"/>
              </Grid>
              <Border Background="#F6FAFA" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,12,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="ROOT 管理器" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                      <RadioButton Content="Vivo KSU" GroupName="KsuVariant" IsChecked="{Binding Root.IsVivoKsuSelected, Mode=TwoWay}" Margin="0,0,18,0" FontSize="12"/>
                      <RadioButton Content="官方 KernelSU" GroupName="KsuVariant" IsChecked="{Binding Root.IsOfficialKsuSelected, Mode=TwoWay}" FontSize="12"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Root.ManagerApkStatus}" FontSize="10" Foreground="{StaticResource ConnectionBrush}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <Grid>
                      <TextBlock Text="KMI" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                      <Button Content="重新识别" Style="{StaticResource ToolButtonStyle}" Command="{Binding Root.ResolveKmiCommand}" HorizontalAlignment="Right" Padding="9,4" FontSize="10" Margin="0"/>
                    </Grid>
                    <CheckBox Content="自动识别（默认）" IsChecked="{Binding Root.UseAutomaticKmi, Mode=TwoWay}" Margin="0,8,0,0" FontSize="11"/>
                    <ComboBox Height="32" Margin="0,7,0,0" ItemsSource="{Binding Root.KmiOptions}" SelectedItem="{Binding Root.SelectedKmi, Mode=TwoWay}">
                      <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource SelectBoxStyle}">
                          <Setter Property="IsEnabled" Value="True"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Root.UseAutomaticKmi}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </ComboBox.Style>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                      <TextBlock Text="生效 KMI: " FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                      <TextBlock Text="{Binding Root.EffectiveKmi}" FontFamily="Cascadia Mono" FontSize="10" Foreground="{StaticResource ConnectionBrush}"/>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Background="#F6FAFA" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,12,0,0">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Root.IsOfficialKsuSelected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <StackPanel>
                  <Grid>
                    <StackPanel>
                      <TextBlock Text="vendor_boot 镜像" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                      <TextBlock Text="{Binding Root.VendorImageName}" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="选择 vendor_boot" Style="{StaticResource ToolButtonStyle}" Command="{Binding Root.BrowseVendorImageCommand}" HorizontalAlignment="Right" Margin="14,0,0,0"/>
                  </Grid>
                  <TextBlock Text="自动处理官方内核与 GKI 内核的模块加载清单；缺 GKI 也不会中断。" FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
              </Border>
              <Border Height="1" Background="{StaticResource EdgeBrush}" Margin="0,16,0,14"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="KSU / 镜像修补" FontSize="14" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Root.PatchedImageName}" FontFamily="Cascadia Mono" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Root.PatchedVendorImageName}" FontFamily="Cascadia Mono" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding Root.IsOfficialKsuSelected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                  <Button Content="全自动 ROOT" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Root.RunAutomaticRootCommand}" Padding="12,7" FontSize="11"/>
                  <Button Content="取消操作" Style="{StaticResource ToolButtonStyle}" Command="{Binding Root.StopCommand}" Padding="11,7" FontSize="11" Margin="8,0,0,0"/>
                  <Button Content="安装管理器" Style="{StaticResource ToolButtonStyle}" Command="{Binding Root.InstallManagerCommand}" Padding="11,7" FontSize="11"/>
                  <Button Content="修补镜像" Style="{StaticResource ToolButtonStyle}" Command="{Binding Root.PatchImageCommand}" Padding="11,7" FontSize="11"/>
                  <Button Content="刷写 init_boot" Style="{StaticResource ToolButtonStyle}" Command="{Binding Root.ContinueToFlashCommand}" Padding="11,7" FontSize="11"/>
