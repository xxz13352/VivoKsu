                        <Style TargetType="Border">
                          <Setter Property="Background" Value="#FFFFFF"/>
                          <Setter Property="BorderBrush" Value="#E8EEF1"/>
                          <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter Property="Background" Value="#F6FAFA"/>
                              <Setter Property="BorderBrush" Value="#C9E3DF"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                              <Setter Property="Background" Value="#EEF8F6"/>
                              <Setter Property="BorderBrush" Value="#AFD8D0"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
