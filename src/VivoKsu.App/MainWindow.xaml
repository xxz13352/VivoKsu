          <Border Grid.Column="1" Style="{StaticResource StatusChipStyle}" VerticalAlignment="Bottom" Visibility="{Binding FirmwareExtract.IsPayloadToolAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
