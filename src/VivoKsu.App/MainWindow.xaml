            <TextBlock Text="VIVO LINE FLASH" Style="{StaticResource PageEyebrowStyle}"/>
            <TextBlock Text="VIVO 线刷" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="查询设备 → 下载 OTA → 解压解包 → 跳过 preloader/lk → fastbootd 刷入其余" Style="{StaticResource PageSubtitleStyle}"/>
          </StackPanel>
          <Border Grid.Column="1" Style="{StaticResource StatusChipStyle}" VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource ConnectionBrush}" Margin="0,4,8,0"/><TextBlock Text="{Binding SafeFlash.StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ConnectionBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
          </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}" Padding="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="24,20,24,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="目标设备" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding SafeFlash.DeviceSummary}" FontSize="13" FontWeight="SemiBold" FontFamily="Cascadia Mono" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="下载+刷入" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SafeFlash.DownloadAndFlashCommand}" Padding="16,8"/>
                <Button Content="选择固件" Style="{StaticResource ToolButtonStyle}" Command="{Binding SafeFlash.SelectAndFlashCommand}" Margin="10,0,0,0" Padding="16,8"/>
                <Button Content="选择解包文件夹" Style="{StaticResource ToolButtonStyle}" Command="{Binding SafeFlash.SelectFolderCommand}" Margin="10,0,0,0" Padding="16,8" AutomationProperties.Name="选择解包文件夹"/>
              </StackPanel>
            </Grid>
            <TextBlock Grid.Row="1" Margin="24,12,24,0" Text="固件中可直接刷写的分区镜像会被逐个刷入,preloader 与 lk 被跳过;含块式内容(如 system/vendor/product 的 .new.dat)的固件会在确认时给出警告。" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            <Border Grid.Row="2" Margin="24,12,24,0" Background="#FFF4F0" BorderBrush="{StaticResource SignalBrush}" BorderThickness="1" Padding="16" CornerRadius="8" Visibility="{Binding SafeFlash.IsConfirmVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="确认刷写" FontSize="14" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding SafeFlash.ConfirmSummary}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                  <TextBlock Text="确认后设备将重启到 fastbootd 并逐个刷入,中途请勿断开连接。" FontSize="11" Foreground="{StaticResource SignalBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="取消" Style="{StaticResource ToolButtonStyle}" Command="{Binding SafeFlash.CancelFlashCommand}"/>
                  <Button Content="确认刷写" Style="{StaticResource SignalButtonStyle}" Command="{Binding SafeFlash.ConfirmFlashCommand}" Margin="10,0,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
            <StackPanel Grid.Row="3" Margin="24,12,24,20">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="当前分区:" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SafeFlash.CurrentPartition}" FontSize="12" FontWeight="SemiBold" FontFamily="Cascadia Mono" VerticalAlignment="Center" Margin="6,0,0,0"/>
              </StackPanel>
              <TextBlock Text="{Binding SafeFlash.StatusText}" FontSize="12" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="2" Background="#F6FAFA" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="22,14">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SafeFlash.SpeedText}" FontFamily="Cascadia Mono" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding SafeFlash.ElapsedText}" FontFamily="Cascadia Mono" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="12,2,0,0"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="停止操作" Style="{StaticResource SignalButtonStyle}" Command="{Binding SafeFlash.StopCommand}" AutomationProperties.Name="停止操作" Margin="0"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- 在线状态(心跳 / 在线用户 / 时长) -->
    <Grid Grid.Row="1" Grid.Column="1">
      <Grid.Style>
        <Style TargetType="Grid">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedPage}" Value="{x:Static models:AppPage.OnlineStatus}">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid Margin="12,30,12,32">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="ONLINE / SESSION" Style="{StaticResource PageEyebrowStyle}"/>
            <TextBlock Text="在线状态" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="实时查看当前在线的 奶蛙Flash 用户与在线时长（每 5 秒同步）" Style="{StaticResource PageSubtitleStyle}"/>
          </StackPanel>
          <Border Grid.Column="1" Style="{StaticResource StatusChipStyle}" VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Online.HeartbeatHealthText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ConnectionBrush}"/>
            </StackPanel>
          </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}" Padding="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="#F6FAFA" BorderBrush="#D8E8E5" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="18,14">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="在线会话" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Online.OnlineCount, StringFormat={}{0} 人在线}" FontFamily="Cascadia Mono" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Online.LastUpdatedText}" FontFamily="Cascadia Mono" FontSize="9" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <Button Content="刷新" Style="{StaticResource ToolButtonStyle}" Command="{Binding Online.RefreshCommand}" Padding="10,5" Margin="0" FontSize="11"/>
                </StackPanel>
              </Grid>
            </Border>
            <Grid Grid.Row="1">
              <ListBox ItemsSource="{Binding Online.Sessions}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Padding="14,4,14,14">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,2"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="2,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Ellipse Width="9" Height="9" Fill="{StaticResource ConnectionBrush}" VerticalAlignment="Center" Margin="6,0,14,0"/>
                      <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                          <Border Background="#EAF7F5" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSelf, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="自己" FontSize="9" Foreground="{StaticResource ConnectionBrush}"/>
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding ClientVersion, StringFormat=版本 {0}}" FontFamily="Cascadia Mono" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="14,0,6,0">
                        <TextBlock Text="在线时长" FontFamily="Cascadia Mono" FontSize="9" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding DurationText}" FontFamily="Cascadia Mono" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource ConnectionBrush}" Margin="0,3,0,0"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Border Background="{StaticResource RailBrush}" IsHitTestVisible="False">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Online.Sessions.Count}" Value="0">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28">
                  <Border Width="38" Height="4" Background="#BDD8D5" CornerRadius="2" HorizontalAlignment="Center"/>
                  <TextBlock Text="NO ACTIVE SESSION" FontFamily="Cascadia Mono" FontSize="9" Foreground="{StaticResource ConnectionBrush}" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                  <TextBlock Text="暂无在线用户" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                  <TextBlock Text="其他客户端登录后将显示在这里" FontFamily="Cascadia Mono" FontSize="9" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Row="2" Background="#F2F8F7" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="0,1,0,0" Padding="18,0">
          <TextBlock Text="{Binding Online.StatusText}" FontFamily="Cascadia Mono" FontSize="9" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
        </Border>
      </Grid>
    </Grid>

    <ScrollViewer Grid.Row="1" Grid.Column="1" Background="{StaticResource CanvasBrush}" VerticalScrollBarVisibility="Auto">
      <ScrollViewer.Style>
        <Style TargetType="ScrollViewer">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedPage}" Value="{x:Static models:AppPage.Software}">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ScrollViewer.Style>
      <StackPanel Margin="12,30,12,32">
        <Grid Margin="0,0,0,22">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="SOFTWARE / STATUS" Style="{StaticResource PageEyebrowStyle}"/>
            <TextBlock Text="软件" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="奶蛙Flash 版本与依赖组件的就绪状态" Style="{StaticResource PageSubtitleStyle}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
            <Button Content="安装组件" Style="{StaticResource ToolButtonStyle}" Command="{Binding Software.OpenResourceDownloaderCommand}" Padding="12,7" Margin="0,0,9,0"/>
            <Button Content="重新检测" Style="{StaticResource ToolButtonStyle}" Command="{Binding Software.RefreshCommand}" Padding="12,7" Margin="0"/>
          </StackPanel>
        </Grid>

        <Border Style="{StaticResource PanelBorderStyle}" Padding="0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Background="#F6FAFA" BorderBrush="#D8E8E5" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="18,14">
              <Grid>
                <TextBlock Text="组件状态" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="SOFTWARE COMPONENTS" FontFamily="Cascadia Mono" FontSize="9" Foreground="{StaticResource ConnectionBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20,16,20,14">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="奶蛙Flash 客户端" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Software.AppVersion, StringFormat=版本 v{0}}" FontFamily="Cascadia Mono" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
              </StackPanel>
              <Border Grid.Column="1" CornerRadius="4" Padding="8,3" Background="#EAF7F5" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="就绪" FontFamily="Cascadia Mono" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource ConnectionBrush}"/>
              </Border>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource EdgeBrush}"/>

            <StackPanel Grid.Row="3" Margin="20,16,20,14">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="手机 USB 驱动" FontSize="14" FontWeight="SemiBold"/>
                  <TextBlock Text="ADB / Fastboot / MediaTek 三类分别检测,任缺一类启动即提醒" FontFamily="Cascadia Mono" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="重新安装" Style="{StaticResource ToolButtonStyle}" Command="{Binding Software.ReinstallDriverCommand}" Padding="12,6" Margin="0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="ADB（WinUSB）" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border Grid.Column="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="#FBEAE7"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Software.IsAdbDriverInstalled}" Value="True"><Setter Property="Background" Value="#EAF7F5"/></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding Software.AdbDriverStatusText}" FontFamily="Cascadia Mono" FontSize="9" FontWeight="SemiBold">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#C85B46"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Software.IsAdbDriverInstalled}" Value="True"><Setter Property="Foreground" Value="{StaticResource ConnectionBrush}"/></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Border>
              </Grid>
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Fastboot（fastbootd 刷写）" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border Grid.Column="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="#FBEAE7"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Software.IsFastbootDriverInstalled}" Value="True"><Setter Property="Background" Value="#EAF7F5"/></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding Software.FastbootDriverStatusText}" FontFamily="Cascadia Mono" FontSize="9" FontWeight="SemiBold">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#C85B46"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Software.IsFastbootDriverInstalled}" Value="True"><Setter Property="Foreground" Value="{StaticResource ConnectionBrush}"/></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Border>
              </Grid>
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="MediaTek（联发科 / BROM 救砖）" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border Grid.Column="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="#FBEAE7"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Software.IsMediaTekDriverInstalled}" Value="True"><Setter Property="Background" Value="#EAF7F5"/></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding Software.MediaTekDriverStatusText}" FontFamily="Cascadia Mono" FontSize="9" FontWeight="SemiBold">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#C85B46"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Software.IsMediaTekDriverInstalled}" Value="True"><Setter Property="Foreground" Value="{StaticResource ConnectionBrush}"/></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Border>
              </Grid>
            </StackPanel>

            <Border Grid.Row="4" Background="{StaticResource EdgeBrush}"/>

            <Grid Grid.Row="5" Margin="20,16,20,14">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="scrcpy 投屏工具" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="投屏所需 scrcpy.exe(内置 / PATH)" FontFamily="Cascadia Mono" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
              </StackPanel>
              <Border Grid.Column="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" Margin="12,0,0,0">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="#FBEAE7"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Software.IsScrcpyReady}" Value="True"><Setter Property="Background" Value="#EAF7F5"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="{Binding Software.ScrcpyStatusText}" FontFamily="Cascadia Mono" FontSize="9" FontWeight="SemiBold">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="#C85B46"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Software.IsScrcpyReady}" Value="True"><Setter Property="Foreground" Value="{StaticResource ConnectionBrush}"/></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Border>
            </Grid>

            <Border Grid.Row="6" Background="{StaticResource EdgeBrush}"/>

            <Grid Grid.Row="7" Margin="20,16,20,14">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="payload_dumper 解包工具" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="固件提取所需 payload_dumper.exe" FontFamily="Cascadia Mono" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
              </StackPanel>
              <Border Grid.Column="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" Margin="12,0,0,0">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="#FBEAE7"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Software.IsPayloadReady}" Value="True"><Setter Property="Background" Value="#EAF7F5"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="{Binding Software.PayloadStatusText}" FontFamily="Cascadia Mono" FontSize="9" FontWeight="SemiBold">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="#C85B46"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Software.IsPayloadReady}" Value="True"><Setter Property="Foreground" Value="{StaticResource ConnectionBrush}"/></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Border>
            </Grid>
          </Grid>
        </Border>

        <Border Style="{StaticResource PanelBorderStyle}" Padding="18" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="需要帮助?" FontSize="13" FontWeight="SemiBold"/>
