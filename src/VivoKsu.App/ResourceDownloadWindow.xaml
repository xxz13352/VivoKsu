<Window x:Class="VivoKsu.App.ResourceDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="548" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True"
        Title="组件安装">

  <Window.Resources>
    <!-- 液态玻璃 sheet:半透明白 + teal 微染渐变,1px 高光边,柔和投影。
         WPF 无 backdrop-filter,毛玻璃由「窗内模糊色斑」垫底 + 本 sheet 半透明叠加近似。 -->
    <Style x:Key="LiquidSheetStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#8CFFFFFF"/>
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EFFFFFFF" Offset="0"/>
            <GradientStop Color="#CCFFFFFF" Offset="0.5"/>
            <GradientStop Color="#D8F1F4F2" Offset="1"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#0B3A4A" Opacity="0.22"/>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 细圆角进度条:确定态用 PART_Indicator(控件按 Value 自动定宽),不确定态滑动光斑。 -->
    <Style x:Key="ThinProgressBarStyle" TargetType="ProgressBar">
      <Setter Property="Height" Value="5"/>
      <Setter Property="Foreground" Value="#087A70"/>
      <Setter Property="Background" Value="#14102531"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
              <Border x:Name="Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/>
              <Border x:Name="GlowRect" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left" Width="0" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsIndeterminate" Value="True">
                <Setter TargetName="Indicator" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="GlowRect" Property="Visibility" Value="Visible"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation Storyboard.TargetName="GlowRect" Storyboard.TargetProperty="Width" From="0" To="90" Duration="0:0:1.1" AutoReverse="True"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 资源状态芯片:颜色随 Status 变(就绪绿 / 下载蓝 / 失败红)。 -->
    <Style x:Key="ResourceChipStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Padding" Value="9,3"/>
      <Setter Property="Background" Value="#F2F5F7"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Ready"><Setter Property="Background" Value="#EAF7F5"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Downloading"><Setter Property="Background" Value="#E7F2FB"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Background" Value="#FBEAE7"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ChipTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#7C8B95"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Ready"><Setter Property="Foreground" Value="{StaticResource ConnectionBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Downloading"><Setter Property="Foreground" Value="#1F6FBF"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Foreground" Value="#C85B46"/></DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="26">
    <!-- 背景模糊色斑:液态玻璃纵深(在 sheet 之下) -->
    <Ellipse Width="230" Height="230" Fill="#66BFE3DC" Margin="-80,-90,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
      <Ellipse.Effect><BlurEffect Radius="60"/></Ellipse.Effect>
    </Ellipse>
    <Ellipse Width="250" Height="250" Fill="#55D9ECF5" Margin="0,0,-80,-100" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
      <Ellipse.Effect><BlurEffect Radius="70"/></Ellipse.Effect>
    </Ellipse>
    <Ellipse Width="150" Height="150" Fill="#44C9E6EE" Margin="0,0,30,130" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
      <Ellipse.Effect><BlurEffect Radius="50"/></Ellipse.Effect>
    </Ellipse>

    <!-- 液态玻璃 sheet -->
    <Border Style="{StaticResource LiquidSheetStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 内顶高光(液态玻璃折射感),覆盖全部三行 -->
        <Rectangle Grid.RowSpan="3" Height="1" VerticalAlignment="Top" Margin="10,0" Fill="#99FFFFFF" IsHitTestVisible="False"/>

        <!-- 顶栏:标题 + 副题 + 关闭 -->
        <Grid Grid.Row="0" Margin="24,20,16,10" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseDown">
          <StackPanel>
            <TextBlock Text="组件安装" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="奶蛙Flash 依赖组件就绪 · 缺失即下载" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
          </StackPanel>
          <Button Style="{StaticResource WindowCloseButtonStyle}" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Click="OnCloseClick" AutomationProperties.Name="关闭组件安装窗"/>
        </Grid>

        <!-- 资源列表:checkbox + 名称 + 大小 + 状态芯片 + 进度条 -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}" Margin="12,2,12,4">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="10,7,10,7">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="152"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected}">
                  <CheckBox.Style>
                    <Style TargetType="CheckBox" BasedOn="{StaticResource ModernCheckBoxStyle}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </CheckBox.Style>
                </CheckBox>
                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="9,0,0,0"/>
                <TextBlock Grid.Column="2" Text="{Binding SizeLabel}" FontFamily="Cascadia Mono" FontSize="9" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <Border Grid.Column="3" Style="{StaticResource ResourceChipStyle}" VerticalAlignment="Center" Margin="10,0,0,0">
                  <TextBlock Text="{Binding StatusText}" Style="{StaticResource ChipTextStyle}" FontFamily="Cascadia Mono" FontSize="9" FontWeight="SemiBold"/>
                </Border>
                <ProgressBar Grid.Column="4" Style="{StaticResource ThinProgressBarStyle}" Minimum="0" Maximum="1"
                             Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}"
                             VerticalAlignment="Center" Margin="12,0,0,0"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 底部:汇总 + 跳过 / 全部安装(下载中变取消) -->
        <Grid Grid.Row="2" Margin="24,10,20,20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding SummaryText}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock FontSize="10" Foreground="{StaticResource ConnectionBrush}" FontFamily="Cascadia Mono" Margin="0,3,0,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="{Binding DownloadingCount, StringFormat={}{0} 项下载中}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding DownloadingCount}" Value="0"><Setter Property="Text" Value="全部就绪或等待选择"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="跳过" Command="{Binding SkipCommand}" AutomationProperties.Name="跳过安装">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
                  <Setter Property="Padding" Value="16,8"/>
                  <Setter Property="Margin" Value="0,0,9,0"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDownloading}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="全部安装" Command="{Binding InstallAllCommand}" AutomationProperties.Name="全部安装">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                  <Setter Property="Padding" Value="18,8"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDownloading}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="取消" Command="{Binding CancelCommand}" AutomationProperties.Name="取消下载">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource SignalButtonStyle}">
                  <Setter Property="Padding" Value="18,8"/>
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDownloading}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
